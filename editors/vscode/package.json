{
  "name": "keepshipping",
  "displayName": "Keep Shipping",
  "description": "Keep Shipping site files: highlighting and language-server support.",
  "publisher": "Keep-Shipping",
  "version": "0.0.1",
  "preview": true,
  "license": "MIT",
  "categories": [
    "Programming Languages"
  ],
  "engines": {
    "vscode": "^1.91.0"
  },
  "main": "./dist/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Keep-Shipping/harness",
    "directory": "editors/vscode"
  },
  "contributes": {
    "languages": [
      {
        "id": "keepshipping",
        "aliases": [
          "Keep Shipping",
          "keepshipping"
        ],
        "filenames": [
          "ship.ks"
        ],
        "filenamePatterns": [
          "*.ship.ks"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "keepshipping",
        "scopeName": "source.keepshipping",
        "path": "./syntaxes/keepshipping.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Keep Shipping",
      "properties": {
        "keepshipping.server.path": {
          "type": "string",
          "default": "keepshipping",
          "description": "Path to the `keepshipping` binary that provides `keepshipping lsp`."
        },
        "keepshipping.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication between VS Code and the language server."
        }
      }
    }
  },
  "scripts": {
    "build": "bun build ./extension.js --target=node --format=cjs --external vscode --outfile=dist/extension.js",
    "package": "bun run build && bunx @vscode/vsce package --pre-release --no-dependencies",
    "publish": "bun run build && bunx @vscode/vsce publish --pre-release --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.2"
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0"
  }
}
