variable "cloudflare_account_id" {
  description = "The Cloudflare account these objects live in."
  type        = string
}
=== modules/example_com/main.tf ===
terraform {
  required_providers {
    cloudflare = {
      source = "cloudflare/cloudflare"
      version = "~> 5.0"
    }
  }
}

resource "cloudflare_dns_record" "kaje" {
  content = "edge.example.net"
  name = "kaje.example.com"
  type = "CNAME"
}

resource "cloudflare_dns_record" "www" {
  content = "edge.example.net"
  name = "www.example.com"
  type = "CNAME"
}

resource "cloudflare_email_routing_rule" "sales" {
  actions = [
    {
      type = "forward"
      value = [var.email_routing_destinations["kaje_sales"]]
    }
  ]
}

resource "cloudflare_zone" "example_com" {
  account = { id = var.cloudflare_account_id }
  name = "example.com"
  type = "full"
}

resource "cloudflare_zone_setting" "ssl" {
  setting_id = "ssl"
  value = "strict"
}

=== modules/example_com/variables.tf ===
variable "cloudflare_account_id" {
  description = "The Cloudflare account these objects live in."
  type        = string
}

variable "email_routing_destinations" {
  description = "Email routing forward destinations, keyed by the rule they belong to."
  type        = map(string)
  sensitive   = true
}
=== modules/test-env/main.tf ===
terraform {
  required_providers {
    cloudflare = {
      source  = "cloudflare/cloudflare"
      version = "~> 5.0"
    }
  }
}

# The test environment. Names here are chosen by Keep Shipping; the database
# details are sensitive variables, never literal values.

resource "cloudflare_d1_database" "test" {
  account_id = var.cloudflare_account_id
  name       = "kaje-test"
}

resource "cloudflare_workers_kv_namespace" "test" {
  account_id = var.cloudflare_account_id
  title      = "kaje-test"
}

resource "cloudflare_r2_bucket" "test" {
  account_id = var.cloudflare_account_id
  name       = "kaje-test"
}

resource "cloudflare_hyperdrive_config" "test" {
  account_id = var.cloudflare_account_id
  name       = "kaje-test"
  origin = {
    scheme   = "postgresql"
    host     = var.test_db_host
    port     = var.test_db_port
    database = var.test_db_database
    user     = var.test_db_user
    password = var.test_db_password
  }
}

data "cloudflare_zone" "test" {
  filter = { name = "example.com" }
}

resource "cloudflare_pages_domain" "test" {
  account_id   = var.cloudflare_account_id
  project_name = "kaje"
  name         = "test.kaje.example.com"
}

resource "cloudflare_dns_record" "test" {
  zone_id = data.cloudflare_zone.test.id
  name    = "test.kaje.example.com"
  type    = "CNAME"
  content = "test.kaje.pages.dev"
  ttl     = 1
  proxied = true
}
