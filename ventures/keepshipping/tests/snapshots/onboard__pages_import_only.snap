=== main.tf ===
terraform {
  required_providers {
    cloudflare = {
      source = "cloudflare/cloudflare"
      version = "~> 5.0"
    }
  }
}

provider "cloudflare" {
  api_token = var.cloudflare_api_token
}

module "account" {
  source = "./modules/account"

  cloudflare_account_id = var.cloudflare_account_id
}

module "example_com" {
  source = "./modules/example_com"

  cloudflare_account_id = var.cloudflare_account_id
  email_routing_destinations = var.email_routing_destinations
}
=== modules/account/main.tf ===
terraform {
  required_providers {
    cloudflare = {
      source = "cloudflare/cloudflare"
      version = "~> 5.0"
    }
  }
}

resource "cloudflare_d1_database" "kaje_db" {
  name = "kaje-db"
}

resource "cloudflare_pages_domain" "kaje_example_com" {
  name = "kaje.example.com"
  project_name = "kaje"
}

resource "cloudflare_pages_project" "kaje" {
  name = "kaje"
  production_branch = "main"
}

resource "cloudflare_workers_kv_namespace" "kaje_cache" {
  title = "kaje-cache"
}

=== modules/account/variables.tf ===
variable "cloudflare_account_id" {
  description = "The Cloudflare account these objects live in."
  type        = string
}
=== modules/example_com/main.tf ===
terraform {
  required_providers {
    cloudflare = {
      source = "cloudflare/cloudflare"
      version = "~> 5.0"
    }
  }
}

resource "cloudflare_dns_record" "kaje" {
  content = "edge.example.net"
  name = "kaje.example.com"
  type = "CNAME"
}

resource "cloudflare_dns_record" "www" {
  content = "edge.example.net"
  name = "www.example.com"
  type = "CNAME"
}

resource "cloudflare_email_routing_rule" "sales" {
  actions = [
    {
      type = "forward"
      value = [var.email_routing_destinations["kaje_sales"]]
    }
  ]
}

resource "cloudflare_zone" "example_com" {
  account = { id = var.cloudflare_account_id }
  name = "example.com"
  type = "full"
}

resource "cloudflare_zone_setting" "ssl" {
  setting_id = "ssl"
  value = "strict"
}

=== modules/example_com/variables.tf ===
variable "cloudflare_account_id" {
  description = "The Cloudflare account these objects live in."
  type        = string
}

variable "email_routing_destinations" {
  description = "Email routing forward destinations, keyed by the rule they belong to."
  type        = map(string)
  sensitive   = true
}
=== variables.tf ===
variable "cloudflare_api_token" {
  description = "Cloudflare API token, supplied through the Secrets port as TF_VAR_cloudflare_api_token."
  type        = string
  sensitive   = true
}

variable "cloudflare_account_id" {
  description = "The Cloudflare account this was imported from."
  type        = string
}

variable "email_routing_destinations" {
  description = "Email routing forward destinations, keyed by the rule they belong to. See IMPORT-REPORT.md."
  type        = map(string)
  sensitive   = true
}
