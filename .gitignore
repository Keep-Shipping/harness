# Rust / Cargo build artifacts
/target

# TypeScript SDK build artifacts and installed packages
sdk/ts/dist/
sdk/ts/node_modules/

# Local credential and secret files — never commit these.
# Environment and shell loaders
.env
.envrc
# Package manager / registry auth
.netrc
.npmrc
.pypirc
# Git credential helpers
.git-credentials
.gitmodules
# MCP client configuration (may embed endpoint tokens)
.mcp.json
# What `keepshipping check` caches beside a site file (script signatures)
.keepshipping/
# Saved plan files written by `tofu plan -out` — binary, and full of secrets
.ks/
